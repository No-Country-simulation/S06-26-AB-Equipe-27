APP_NAME=SkillFocus
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.onrender.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Render PostgreSQL (gera essa URL automaticamente ao ligar um serviço Postgres) ---
# Render cria a variável DATABASE_URL automaticamente. Copie manualmente apenas se não detectar.
# Exemplo: DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_URL=

DB_CONNECTION=pgsql
# Se não usar DATABASE_URL, preencha manualmente:
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=public
# Render Managed Postgres exige SSL:
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@skillfocus.com.br"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==========================================================
# Integração Python (extração de currículo + matching IA)
# ==========================================================

# Caminho do interpretador Python com as dependências instaladas
# - Container Docker: /opt/venv/bin/python (padrão do nosso Dockerfile)
# - Windows dev:  C:\Projetos\skillfocus\app\scripts\.venv\Scripts\python.exe
# - Linux/mac dev: ./app/scripts/.venv/bin/python3
PYTHON_BIN=/opt/venv/bin/python

# Chave Google Gemini — gerar em https://aistudio.google.com/apikey
# Recomendado: usar modelo Gemini 2.0 Flash (ativo) ou mais novo
GEMINI_API_KEY=

# Modelo padrão usado pelo extractor; o script automaticamente faz fallback para
# gemini-2.5-flash-lite -> gemini-1.5-flash se o principal estiver indisponível.
GEMINI_MODEL=gemini-2.0-flash
